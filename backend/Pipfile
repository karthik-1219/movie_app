[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
Flask = "==2.2.3"
Flask-Cors = "==3.0.10"
werkzeug = "==2.2.2"

[dev-packages]
pytest = "==7.2.1"
coverage = "*"
flake8 = "*"
black = "*"

[requires]
python_version = "3.10"

[scripts]
serve = "flask --app . run --port 5000 --debug"
test = "pytest -v"
lint = "flake8"
report = "coverage run -m pytest -v"
lint-fail = "flake8 --max-line-length=88"
